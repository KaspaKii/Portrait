contract MerkleProofOfSolvency(int max_ins, int max_outs, pubkey init_attestor, int init_epoch, bool init_solvent, byte[32] init_liabilities_root, byte[32] init_reserves_root, int init_seq) {
    pubkey attestor = init_attestor;
