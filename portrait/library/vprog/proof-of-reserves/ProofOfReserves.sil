contract ProofOfReserves(int max_ins, int max_outs, pubkey init_attestor, int init_epoch, bool init_solvent, byte[32] init_accounts_root, int init_seq) {
    pubkey attestor = init_attestor;
    int epoch = init_epoch;
    bool solvent = init_solvent;
    byte[32] accounts_root = init_accounts_root;
    int seq = init_seq;

    #[covenant(binding = cov, from = max_ins, to = 1, mode = transition)]
    function attest(State[] prev_states, sig auth, bool next_solvent, byte[32] next_accounts_root, byte[32] proof_cov_id) : (State) {
