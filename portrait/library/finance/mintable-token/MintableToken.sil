pragma silverscript ^0.1.0;

// Generated by portrait build
contract MintableToken(int max_ins, int max_outs, pubkey init_issuer, int init_supply) {
    pubkey issuer = init_issuer;
    int supply = init_supply;

    #[covenant(binding = cov, from = max_ins, to = 1, mode = transition)]
    function mint(State[] prev_states, sig auth, int amount) : (State) {
        require(checkSig(auth, prev_states[0].issuer));
        require(amount >= 0);
        return({ issuer: prev_states[0].issuer, supply: prev_states[0].supply + amount });
    }
}
