    "span": "contract Escrow(int max_ins, int max_outs, pubkey init_buyer, pubkey init_seller, int init_amount, int init_deadline) {\n    pubkey buyer = init_buyer;\n    pubkey seller = init_seller;\n    int amount = init_amount;\n    int deadline = init_deadline;\n\n    #[covenant(binding = auth, from = max_ins, to = 1, mode = verification)]\n    function release(State prev_state, State[] new_states, sig auth) {\n        require(checkSig(auth, prev_state.seller));\n        require(tx.outputs[0].value == prev_state.amount);\n        require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(prev_state.seller)));\n    }\n\n    #[covenant(binding = auth, from = max_ins, to = 1, mode = verification)]\n    function refund(State prev_state, State[] new_states, sig auth) {\n        require(checkSig(auth, prev_state.buyer));\n        require(tx.outputs[0].value == prev_state.amount);\n        require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(prev_state.buyer)));\n        require(tx.time >= prev_state.deadline);\n    }\n}",
    "name_span": "Escrow"
