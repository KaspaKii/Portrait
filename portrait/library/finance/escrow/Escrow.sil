pragma silverscript ^0.1.0;

// Generated by portrait build
contract Escrow(int max_ins, int max_outs, pubkey init_buyer, pubkey init_seller, int init_amount, int init_deadline) {
    pubkey buyer = init_buyer;
    pubkey seller = init_seller;
    int amount = init_amount;
    int deadline = init_deadline;

    #[covenant(binding = auth, from = max_ins, to = 1, mode = verification)]
    function release(State prev_state, State[] new_states, sig auth) {
        require(checkSig(auth, prev_state.seller));
        require(tx.outputs[0].value == prev_state.amount);
        require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(prev_state.seller)));
    }

    #[covenant(binding = auth, from = max_ins, to = 1, mode = verification)]
    function refund(State prev_state, State[] new_states, sig auth) {
        require(checkSig(auth, prev_state.buyer));
        require(tx.outputs[0].value == prev_state.amount);
        require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(prev_state.buyer)));
        require(tx.time >= prev_state.deadline);
    }
}
